<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://omaker.org/onto/teste_real.owl"
         xmlns="http://omaker.org/onto/teste_real.owl#">

<owl:Ontology rdf:about="http://omaker.org/onto/teste_real.owl"/>

<owl:ObjectProperty rdf:about="#treats">
  <rdfs:domain rdf:resource="#Drug"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#prevents">
  <rdfs:domain rdf:resource="#Drug"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#causes"/>

<owl:Class rdf:about="#BiomedicalEntity">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Drug">
  <rdfs:subClassOf rdf:resource="#BiomedicalEntity"/>
</owl:Class>

<owl:Class rdf:about="#Symptom">
  <rdfs:subClassOf rdf:resource="#BiomedicalEntity"/>
</owl:Class>

<owl:Class rdf:about="#Disease">
  <rdfs:subClassOf rdf:resource="#BiomedicalEntity"/>
</owl:Class>

<owl:Class rdf:about="#Gene">
  <rdfs:subClassOf rdf:resource="#BiomedicalEntity"/>
</owl:Class>

<owl:Class rdf:about="#Analgesic">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#Anticoagulant">
  <rdfs:subClassOf rdf:resource="#Drug"/>
</owl:Class>

<owl:Class rdf:about="#NeurologicalDisease">
  <rdfs:subClassOf rdf:resource="#Disease"/>
</owl:Class>

<owl:Class rdf:about="#Cancer">
  <rdfs:subClassOf rdf:resource="#Disease"/>
  <owl:disjointWith rdf:resource="#NeurologicalDisease"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#Aspirin">
  <rdf:type rdf:resource="#Anticoagulant"/>
  <prevents rdf:resource="#stroke"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aspirin</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#stroke">
  <rdf:type rdf:resource="#NeurologicalDisease"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stroke</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Chemotherapy">
  <rdf:type rdf:resource="#Drug"/>
  <treats rdf:resource="#tumor"/>
  <causes rdf:resource="#nausea"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chemotherapy</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#tumor">
  <rdf:type rdf:resource="#Cancer"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tumor</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#nausea">
  <rdf:type rdf:resource="#Symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nausea</rdfs:label>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Drug"/>
    <rdf:Description rdf:about="#Symptom"/>
    <rdf:Description rdf:about="#Disease"/>
    <rdf:Description rdf:about="#Gene"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
