</owl:Class>

<owl:Class rdf:about="#Organizacao">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Instituicao">
  <rdfs:subClassOf rdf:resource="#Organizacao"/>
</owl:Class>

<owl:Class rdf:about="#Localizacao">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PocoDeAgua">
  <rdfs:subClassOf rdf:resource="#Localizacao"/>
</owl:Class>

<owl:Class rdf:about="#EntidadeMitologica">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#ConceitoAbstrato">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#CienciaMedica">
  <rdfs:subClassOf rdf:resource="#ConceitoAbstrato"/>
</owl:Class>

<owl:Class rdf:about="#Tratamento">
  <rdfs:subClassOf rdf:resource="#ConceitoAbstrato"/>
</owl:Class>

<owl:Class rdf:about="#Diagnostico">
  <rdfs:subClassOf rdf:resource="#ConceitoAbstrato"/>
</owl:Class>

<owl:NamedIndividual rdf:about="#PandemiaPesteNegra">
  <rdf:type rdf:resource="#PesteNegra"/>
  <impactou rdf:resource="#GuerraDosCemAnos"/>
  <impactou rdf:resource="#IgrejaCatolica"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#GuerraDosCemAnos">
  <rdf:type rdf:resource="#Conflito"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#IgrejaCatolica">
  <rdf:type rdf:resource="#Instituicao"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Demonio">
  <rdf:type rdf:resource="#EntidadeMitologica"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CienciaMedicaDaEpoca">
  <rdf:type rdf:resource="#CienciaMedica"/>
  <foiDeficienteEmRelacaoA rdf:resource="#PandemiaPesteNegra"/>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#FebreAlta"/>
    <rdf:Description rdf:about="#Calafrio"/>
    <rdf:Description rdf:about="#DorNoCorpo"/>
    <rdf:Description rdf:about="#DorDeCabeca"/>
    <rdf:Description rdf:about="#Nausea"/>
    <rdf:Description rdf:about="#Vomito"/>
    <rdf:Description rdf:about="#Convulsao"/>
    <rdf:Description rdf:about="#ManchaNegra"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#PesteBubonica"/>
    <rdf:Description rdf:about="#PesteSepticemica"/>
    <rdf:Description rdf:about="#PestePneumonica"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
