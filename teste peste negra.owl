</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#associadoA">
  <rdfs:domain rdf:resource="#Gato"/>
  <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#quaseCausouExtincaoDe">
  <rdfs:domain rdf:resource="#PesteNegra"/>
  <rdfs:range rdf:resource="#Gato"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#foiDeficienteEmRelacaoA">
  <rdfs:domain rdf:resource="#CienciaMedica"/>
  <rdfs:range rdf:resource="#PesteNegra"/>
</owl:ObjectProperty>

<owl:Class rdf:about="#Doenca">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#PesteNegra">
  <rdfs:subClassOf rdf:resource="#Doenca"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#eTransmitidaPor"/>
      <owl:someValuesFrom rdf:resource="#RatoNegro"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#causa"/>
      <owl:someValuesFrom rdf:resource="#ManchaNegra"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#resultaEmMorteDe"/>
      <owl:someValuesFrom rdf:resource="#Pessoa"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#causa"/>
      <owl:someValuesFrom rdf:resource="#FebreAlta"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#causa"/>
      <owl:someValuesFrom rdf:resource="#Calafrio"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#causa"/>
      <owl:someValuesFrom rdf:resource="#DorNoCorpo"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#causa"/>
      <owl:someValuesFrom rdf:resource="#DorDeCabeca"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#causa"/>
      <owl:someValuesFrom rdf:resource="#Nausea"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#causa"/>
      <owl:someValuesFrom rdf:resource="#Vomito"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#causa"/>
      <owl:someValuesFrom rdf:resource="#Convulsao"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temEstagio"/>
      <owl:someValuesFrom rdf:resource="#PesteBubonica"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temEstagio"/>
      <owl:someValuesFrom rdf:resource="#PesteSepticemica"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#temEstagio"/>
      <owl:someValuesFrom rdf:resource="#PestePneumonica"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#quaseCausouExtincaoDe"/>
      <owl:someValuesFrom rdf:resource="#Gato"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#EstagioPesteNegra">
  <rdfs:subClassOf rdf:resource="#PesteNegra"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#requer"/>
      <owl:someValuesFrom rdf:resource="#Tratamento"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#requer"/>
      <owl:someValuesFrom rdf:resource="#Diagnostico"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#PesteBubonica">
  <rdfs:subClassOf rdf:resource="#EstagioPesteNegra"/>
</owl:Class>

<owl:Class rdf:about="#PesteSepticemica">
  <rdfs:subClassOf rdf:resource="#EstagioPesteNegra"/>
</owl:Class>

<owl:Class rdf:about="#PestePneumonica">
  <rdfs:subClassOf rdf:resource="#EstagioPesteNegra"/>
</owl:Class>

<owl:Class rdf:about="#Sintoma">
