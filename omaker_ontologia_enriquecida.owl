  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000889</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">remittent fever</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000890">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000613"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by  body temperature periodically rising and falling.</obo:IAO_0000115>
