</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#temEstagio">
  <rdfs:domain rdf:resource="#PesteNegra"/>
  <rdfs:range rdf:resource="#EstagioPesteNegra"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#requer">
  <rdfs:domain rdf:resource="#EstagioPesteNegra"/>
  <rdfs:range rdf:resource="#ConceitoAbstrato"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#atribuiuCausaA">
