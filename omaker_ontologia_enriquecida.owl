  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000358</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">premature labor</rdfs:label>
</owl:Class>

