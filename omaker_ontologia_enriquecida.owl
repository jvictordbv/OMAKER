<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000542">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000457"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abdominal pain that is characterized by occurring in the epigastrium, i.e. the upper part of the abdomen below the rib cage.</obo:IAO_0000115>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ICD9CM_2005:789.06</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">UMLS_CUI:C0232493</oboI:hasDbXref>
