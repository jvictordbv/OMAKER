  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">doid/symp duplicate</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relapsing fever</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000893">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000692"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A low blood pressure characterized by or due to abnormally low blood pressure, especially in the arteries of the systemic circulation.</obo:IAO_0000115>
