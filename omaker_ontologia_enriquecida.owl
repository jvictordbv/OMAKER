  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">obsolete gain of weight</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
