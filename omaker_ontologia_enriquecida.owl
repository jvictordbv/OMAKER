  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inability to perceive pitch, rhythm, and emotional tone of speech</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sensory aphasia</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000219</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">receptive aphasia</rdfs:label>
</owl:Class>

