  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">developmental delay</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
