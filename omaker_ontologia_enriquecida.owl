<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020065"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A general symptom that is characterized by unusual and painful sensitivity to touch, pressure or palpation of a specific anatomical point.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Tenderness_(medicine)</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/tenderness</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.handsurgeryresource.net/tenderness</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/tenderness</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020062"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A musculoskeletal system symptom that is characterized by necrosis (i.e. tissue death) of soft tissue, including muscle, fat, blood vessels, nerves, tendons, and tissues that surround the bones and joints.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/001443.htm</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.health.ny.gov/statistics/cancer/registry/abouts/soft_tissue.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020061"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A constipation that is characterized by difficulty passing bowel movements after they reach the rectum. One experiences difficulty evacuating the stool and often has to strain or press the fingers into the vagina or in front of or into the rectum to help remove the stool. Outlet dysfunction can be caused by inappropriate or abnormal muscle contraction of the pelvic floor (called pelvic floor dyssynergia or dyssynergic defecation) which can respond to biofeedback. It may also be due to a rectocele or other structural changes in the pelvic floor that will require medical or at times, surgical treatment.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.med.unc.edu/ibs/wp-content/uploads/sites/450/2017/10/Constipation.pdf</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020057"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by acute inflammation of the bronchi, accompanied by inflamed patches in the nearby lobules of the lungs.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Bronchopneumonia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020056"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by a loss of blood flow to part of the brain, which damages brain tissue. Cerebrovascular accidents are caused by blood clots and broken blood vessels in the brain.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/cerebrovascular-accident</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020054"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mammary gland inflammation that is characterized by an increased intensity or severity of the condition.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/severe</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020053"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an inflammation of the mammary gland or udder and usually caused by infection.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=mastitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020052"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A muscle weakness that is characterized by a reduction in muscle strength, which may be the result of a variety of conditions, such as carpal tunnel syndrome, arthritis, peripheral neuropathy, tendon damage, and ganglion cysts.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.buoyhealth.com/learn/hand-weakness</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.medicalnewstoday.com/articles/hand-weakness</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020051"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by a reduction in the chemical reactions catalyzed by enzymes, which keep us alive. Metabolism allows organisms to grow, reproduce, maintain their structures, and respond to their environments and can be divided into catabolism (breaking down of organic matter) and anabolism (building of molecules).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://simple.wikipedia.org/wiki/Metabolism</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020050"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An eye symptom that is characterized by a reduction in the saline fluid secreted by the lacrimal gland.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/tear</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020049"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by the delay in development child's cognitive, emotional, motor, and social capacities from the beginning of life throughout fetal and neonatal periods, infancy, childhood, and adolescence.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://pubmed.ncbi.nlm.nih.gov/23622146/</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/parenting/baby/recognizing-developmental-delays-birth-age-2</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020047"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paralysis that is characterized by a loss of motor function in one or more muscles, which can also be accompanied by a loss of feeling (sensory loss). Descending paralysis contrasts with ascending paralysis in that descending paralysis presents in the upper limbs before the lower limbs. Descending paralysis occurs in conditions such as botulism.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Paralysis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020046"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A feeding difficulties and mismanagement that is characterized by delays and/or disorders in the development of eating and drinking skills including disordered placement of food in the mouth, difficulty in appropriately manipulating food when it is in the mouth, difficulty chewing, and/or difficulty swallowing.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://link.springer.com/referenceworkentry/10.1007/978-1-4419-1698-3_1666</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020045"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by any of the following: dizziness or vertigo (a spinning sensation); falling or feeling as if you are going to fall; staggering when walking; lightheadedness, faintness, or a floating sensation; and confusion or disorientation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nidcd.nih.gov/health/balance-disorders</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020044"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hair symptom that is characterized by significant falling out of hair, which may be a result of stress, high fever, and other factors.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.aad.org/public/diseases/hair-loss/insider/shedding</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020043"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by an elevation in the concentration of the the pigments from foods, dyes, and medications in urine. The dilution of these pigment is dependent on the amount of water intake and severe dehydration can lead to a dark color.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.mayoclinic.org/diseases-conditions/urine-color/symptoms-causes/syc-20367333</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020042"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cornea symptom that is characterized by scarring (an opacity or irregularity in the cornea) of the cornea, from trauma; abrasion; bacterial, fungal, viral, or parasitic infection; or disease, and can result in impaired vision, or even blindness.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://drstuartterry.com/eye-conditions/corneal-scarring/</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.neohioeyes.com/cornea-center/corneal-scar/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020041"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hair symptom that is characterized by coiled “corkscrew” hairs on the surface of the arms, legs and chest, which can occur as a result low level of ascorbic acid (vitamin C).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/imagepages/2345.htm</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ccjm.org/content/ccjom/82/4/216.full.pdf</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.miningjournal.net/life/tuesday-health/2021/09/urology-pearls-the-mystery-of-the-corkscrew-hair-part-2/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020039"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A musculoskeletal system symptom that is characterized by a permanent tightening of the muscles, tendons, skin, and nearby tissues that causes the joints to shorten and become very stiff.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.cancer.gov/publications/dictionaries/cancer-terms/def/contracture</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020037"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An eye symptom that is characterized by (need def conjunctival suffusion - placeholder for xref).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Conjunctival_suffusion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020035"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An eye symptom that is characterized by (need def conjunctival congestion - placeholder for xref).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://pubmed.ncbi.nlm.nih.gov/32283878/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020031"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by pain, pressure, tightness, or other discomfort originating in or radiating to the chest, which constitutes an important indicator of potentially serious cardiac or cardiovascular disorders.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK416/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020030"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hair symptom that is characterized by patchy hair loss and the presence of comedo-like cadaver hairs, which appear as black dots.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4148295/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020029"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of consciousness that is characterized by a decreased ability to focus one's thoughts on something. Concentration difficulties can be related to difficulty staying awake, impulsiveness, intrusive thoughts or concerns, overactivity, or inattention. They can be caused by medical, cognitive or psychological problems, or, may be related to sleep disorders, medications, alcohol, or drugs.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthgrades.com/right-care/symptoms-and-conditions/concentration-difficulty</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020027"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cough that is characterized by a production and expectoration (bringing up) of mucus (phlegm) or sputum.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/lung/productive-cough-causes</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020025"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by necrosis of tissue with conversion of damaged tissue into a soft cheesy substance.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/caseation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020024"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by constriction of the air passages of the lung (as in asthma) by spasmodic contraction of the bronchial muscles.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/bronchospasm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020022"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An ear symptom - need proper definition - placeholder for xref.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://hearinghealthfoundation.org/blogs/deciphering-a-mechanism-behind-bone-conduction-hyperacusis#:~:text=An%20example%20is%20bone%20conduction,canals%20in%20the%20inner%20ear.</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020018"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight symptom that is characterized by being too heavy for one’s height. Excess body weight can come from fat, muscle, bone, and/or water retention. Being overweight does not always mean being obese.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.cancer.gov/publications/dictionaries/cancer-terms/def/overweight</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020017"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight gain that is characterized by conditions that last 1 year or more and require ongoing medical attention, or limit activities of daily living, or both.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.cdc.gov/chronicdisease/about/index.htm#</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020016"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight gain that is characterized by a severe and sudden onset.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/imagepages/18126.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020014"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight loss that is characterized by conditions that last 1 year or more and require ongoing medical attention, or limit activities of daily living, or both.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.cdc.gov/chronicdisease/about/index.htm#</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020013"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight loss that is characterized as deviating from what is normal or usual, typically in a way that is undesirable or worrying.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/abnormal</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020008"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cough that is characterized by a tight, low-pitched, and barky (like a barking seal) cough.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.seattlechildrens.org/conditions/a-z/croup/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020006"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a feeling of irritability or severe restlessness.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK493153/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020004"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A disturbances of sensation of smell and taste that is characterized by a complete loss of taste function of the tongue.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK549775/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020001"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin ulcer that is characterized by a small recurrent, painful, round or ovoid ulcers with well-defined erythematous margins, like a halo, and a central yellow or gray floor found in the soft tissue of the oral cavity.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Aphthous_stomatitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0020000"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by a narrowing in the airway that obstructs the passage of air into the lungs.  Examples include tracheal and laryngotracheal stenosis.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://throatdisorder.com/breathing-disorders/tracheal-stenosis/</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK554561/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019190"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hemorrhage that is characterized by bleeding that occurs within the skull of head but outside the actual brain tissue.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://my.clevelandclinic.org/health/diseases/21183-subdural-hematoma</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019189"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hemorrhage that is characterized by bleeding within the brain tissue itself.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://mayfieldclinic.com/pe-ich.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019188"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hemorrhage that is characterized by any bleeding occurring within the skull.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK542273/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019187"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A behavioral symptom that is characterized by an unusual repetitive motor movements or manipulation of objects.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.autism.org.uk/about/behaviour/obsessions-repetitive-routines.aspx##repetitive</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019186"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A behavioral symptom that is characterized by obsessive and highly-focused interests.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.autism.org.uk/about/behaviour/obsessions-repetitive-routines.aspx</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Perseveration</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019185"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A behavioral symptom that is characterized by speech, language and communication needs or communication disabilities.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.mhldcc.org.uk/contents/6-communication-difficulties/a-what-are-communication-difficulties.aspx</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019184"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A behavioral symptom that is characterized by a restricted rate of information processing by the brain.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/pubmed/15084813</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019183"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A behavioral symptom that is characterized by an increase in movement, impulsive actions, a shorter attention span, and being easily distracted.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003256.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019182"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by an involvement, or relation to, or emphasizes behavior.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://dictionary.cambridge.org/dictionary/english/behavioural</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019180"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Constipation is a feces and droppings symptom involving the abnormally delayed or infrequent passage of dry hardened feces. Constipation may be categorized into three subtypes: normal-transit, slow-transit, and pelvic floor dysfunction.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=constipation</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3170709/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019179"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A  balance symptom that is characterized by a condition of being dizzy or on the verge of fainting, particularly when one arises to a standing position. Lightheadedness is a predictable consequence of any medication tending to lower blood pressure.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=light-headedness</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019178"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by regions of cell death to living tissue in an organ, which has suffered damage through injury or disease, such as a wound, ulcer, abscess, or tumor.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Lesion</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Necrosis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019177"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a weariness or exhaustion from labor, exertion, or stress.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=fatigue</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019176"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by an indefinite feeling of debility or lack of health, often indicative of or accompanying the onset of an illness.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=malaise</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019175"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by the excretion of moisture in visible quantities through the opening of the sweat glands.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sweat</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019173"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by an inflammation of the meninges and especially of the pia mater and the arachnoid.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=meningitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019171"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by an inflammation of the vertebrae.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=spondylitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019169"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arthritis is a musculoskeletal system symptom characterized as an inflammation of joints due to infectious, metabolic, or constitutional causes.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=arthritis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019168"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pneumonitis that is characterized by an inflammatory illness of the lung resulting from a variety of causes including infection with bacteria, viruses, fungi, or parasites, and chemical or physical injury to the lungs. Its cause may also be officially described as idiopathic, that is, unknown, when infectious causes have been excluded.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Pneumonia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019167"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a small circumscribed elevation of the skin containing pus and having an inflamed base.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=pustule</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019161"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a pain in one or more muscles.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=myalgia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019160"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a localized swelling and inflammation of the skin resulting from usually bacterial infection of a hair follicle and adjacent tissue, having a hard central core, and forming pus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=boil</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019158"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a scab formed especially after a burn.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=eschar</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019154"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by inflammation of the mediastinum (the chest cavity, which contains the heart, the thymus gland, some lymph nodes, and parts of the esophagus, aorta, thyroid, and parathyroid glands) as the result of bleeding.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merckmanuals.com/home/lung-and-airway-disorders/pleural-and-mediastinal-disorders/mediastinitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019153"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by difficult or labored respiration.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=dyspnea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019152"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sweat that is characterized by excessive sweating commonly associated with shock and other medical emergency conditions.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Diaphoresis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019151"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by an abnormal accumulation of fluid in the lungs.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=pulmonary%20edema</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019147"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A vomiting where there is vomiting of blood.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hematemesis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019145"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vomiting is a digestive system symptom characterized by throwing up the stomach contents.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/dictionary/vomiting</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000900"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An immune system symptom that is characterized by sensitivities to substances called allergens.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/000005.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000899"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cardiac fibrillation associated with quivering of the lower chambers of the heart, preventing blood from being pumped and causing cardiac arrest.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.heart.org/HEARTORG/Conditions/Arrhythmia/AboutArrhythmia/Ventricular-Fibrillation_UCM_324063_Article.jsp#.WvWbgFMvwnU</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000898"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An arrhythmia characterized by rapid, irregular, and unsynchronized contraction of muscle fibers within the heart.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Fibrillation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000897"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A bradycardia associated with the generation of impules in the ventricles when impules from the atria fail to reach them, characterized by an electrocardiogram showing a heart rate below 50 BPM and a broad QRS complex.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Ventricular_escape_beat</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000896"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abnormal protrusion or displacement of an eye or other body part.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Exophthalmos</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merckmanuals.com/professional/eye-disorders/symptoms-of-ophthalmologic-disorders/proptosis</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nhs.uk/conditions/bulging-eyes/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000895"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An acute allergic reaction to an antigen to which the body has become hypersensitive.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Anaphylaxis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000894"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by cold, moist and sticky skin.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/medlineplus/clammy</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000893"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A low blood pressure characterized by or due to abnormally low blood pressure, especially in the arteries of the systemic circulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hypotension</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/medlineplus/hypotensive</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000892"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by interpretation of the information perceived by sensory receptors.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.audiblox2000.com/sensation-perception.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000890"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by  body temperature periodically rising and falling.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merckmanuals.com/professional/infectious-diseases/spirochetes/relapsing-fever</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000889"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by a fever where the temperature remains above normal throughout the day and fluctuates more than 1 degree Celsius in 24 hours.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Fever#Types</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000888"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by a temperature remaining above normal throughout the day and which does not fluctuate more than 1 degree Celsius in 24 hours.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Fever#Types</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000887"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by association with Hodgkin's lymphoma, where the fever alternates weekly from high to low.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Fever</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000886"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by an extreme elevation of body temperature greater than, or equal to, 41.5 degrees Celsius (106.7 degrees Fahrenheit).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Fever</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000883"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A high fever that is characterized by extremely high temperatures.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.wrongdiagnosis.com/sym/very_high_fever.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000882"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by an elevated temperature.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.wrongdiagnosis.com/sym/high_fever.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000881"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by being mild in form.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.wrongdiagnosis.com/sym/mild_fever.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000880"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by as  persisting over a prolonged period of time.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.wrongdiagnosis.com/sym/prolonged_fever.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000879"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mild fever that is characterized by a fever that does not exceed 38.5 degrees Celsius (101.3 degrees Fahrenheit).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.wrongdiagnosis.com/sym/low_grade_fever.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000878"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by a rise of body temperature above the normal that is sustained for only a short period of time.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wiktionary.org/wiki/fever</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wiktionary.org/wiki/transient</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000876"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pericardial effusion is a cardiovascular system symptom where there is an abnormal accumulation of fluid in the pericardial cavity.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Pericardial_effusion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000875"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lameness is a musculoskeletal system symptom where a person is physically disabled as the result of having a body part and especially a limb so disabled as to impair freedom of movement.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/dictionary/lame</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000874"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a mass of usually clotted blood that forms in a tissue, organ, or body space as a result of a broken blood vessel generally the result of hemorrhage, or more specifically, internal bleeding.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hematoma</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=Hematomas</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000873"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Otitis is a ear symptom characterized as a general term for inflammation or infection of the ear, in both humans and other animals.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Otitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000872"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by yellowed skin due to bile or bilirubin accumulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Jaundice</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000871"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by yellowed mucous membranes due to bile or bilirubin accumulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Jaundice</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000870"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Icteric eyes is a eye symptom characterized by yellowed eyes due to bile or bilirubin accumulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Jaundice</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www3.niaid.nih.gov/labs/aboutlabs/cmb/InfectiousDiseasePathogenesisSection/mouseNecropsy/necropsyTerms.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000869"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A congestion that is characterized by a blockage of the nasal passages, usually due to the membranes lining the nose becoming swollen from inflamed blood vessels.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Nasal_congestion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000868"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by a shortness of breath, a hard or uncomfortable intake of air, or the feeling that you're not getting enough air.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nlm.nih.gov/medlineplus/breathingproblems.html</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000867"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A digestive system symptom characterized by bleeding from one or more of the areas of the digestive or gastrointestinal (GI) tract that includes the espophagus, stomach, small intestine, large intestine or colon, rectum and anus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nlm.nih.gov/medlineplus/gastrointestinalbleeding.html</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000866"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cervical edema is a neck symptom characterized by an abnormal excess accumulation of serous fluid in the soft tissue of the cervical area.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=edema</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000863"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Facial tremor is a head symptom characterized by a trembling or shaking of the muscles of the face usually from physical weakness, emotional stress, or disease, may be emphasized by the firm closure of the eyes, elevation of the eyebrows, or drawing down and outward of the corners of the mouth.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://books.google.com/books/pdf/Medical_Diagnosis_for_the_Student_and_Pr.pdf?id=NWOYzn2-_pcC&amp;output=pdf&amp;sig=ACfU3U01YhXqEIhGHVTFAnUinc9-Q8INRQ</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/dictionary/tremors</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000862"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by pain which is subjectively localized in one region although it is due to irritation in another region.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=referred%20pain</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000861"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Freezing hypokinesia is a hypkinesia where a person can not move their muscles how they want them to.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hypokinesia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000860"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Postural instability hypokinesia is a hypokinesia described as a loss of ability to maintain an upright posture.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hypokinesia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000859"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rigidity hypokinesia a type of hypokinesia described as the increase in muscle tension when moved by an outside force.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hypokinesia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000858"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypokinesia is a musculoskeletal system  symptom characterized by the slow or diminished movement of body musculature. It may be associated with basal ganglia diseases; mental disorders; prolonged inactivity due to illness; experimental protocols used to evaluate the physiologic effects of immobility; and other conditions.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hypokinesia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000857"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A vertigo that is characterized by a sensation that the external world is revolving.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=objective+vertigo</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000856"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A vertigo that is characterized by a sensation that one's body is revolving in space.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=subjective+vertigo</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000855"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A menorrhagia that is characterized by an irregular uterine bleeding, especially between menstrual periods.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=metrorrhagia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000854"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A menorrhagia that is characterized by an abnormally profuse or prolonged menstrual flow.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hypermenorrhea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000853"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary incontinence that is characterized by an involuntary leakage of urine from the bladder accompanying physical activity (as in laughing, coughing, sneezing, or physical exercise) which places increased pressure on the abdomen.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=stress%20incontinence</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.health.harvard.edu/bladder-and-bowel/types-of-urinary-incontinence</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000852"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by the absence of, or by defective, urine excretion.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=anuria</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000851"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hematuria that is characterized by the production of a visible redness in the urine.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=gross%20hematuria</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000850"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Congested sclera is a hyperemia characterized as the congestion of the vessels of the outer layer of the eye containing collagen and elastic fibers.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Sclera</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000849"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by the birth of a dead fetus; in which  a fetus that has died in the uterus, or during labor, or delivery, exits a woman's body.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Still_birth</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=stillbirth</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000848"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paralysis that is characterized by a complete or partial loss of function the voluntary muscles.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=motor%20paralysis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000847"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paralysis that is characterized by a tonic spasm of the affected muscles and with increased tendon reflexes.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=spastic%20paralysis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000846"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hyperemia of the chest is a cardiovascular system symptom consisting of an excess of blood in the tissues of the chest as from an increased flow of blood due to vasodilation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hyperemia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000845"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hyperemia of the neck is a neck symptom consisting of an excess of blood in the tissues of the neck as from an increased flow of blood due to vasodilation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hyperemia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000844"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hyperemia of the face is a head symptom consisting of an excess of blood in the tissues of the face as from an increased flow of blood due to vasodilation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hyperemia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000843"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Functional hyperemia is a hyperemia occurring due to an increase in blood flow to a tissue due to the presence of metabolites and a change in general conditions.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hyperemia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000842"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Active hyperemia is a hyperemia occurring due to the dilation of arteriolar smooth muscle to increase blood flow in response to an increase in metabolism.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hyperemia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000841"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reactive hyperemia is a hyperemia occurring due to the dilation of arteriolar smooth muscle to increase blood flow in response to a profound increase in blood flow to an organ after being occluded. There will be a shortage of oxygen and a build-up of metabolic waste.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Hyperemia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000840"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a painful sensation with a normal, non-painful stimulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000839"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by being severe but lasting a relatively short time.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000838"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by occurring with movement and is not controlled by a scheduled pain medication regimen, such that the pain breaks through the current regimen. This is usually referred to in the context of a short and long acting opioid, the short acting opioid being used to treat the breakthrough pain.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000837"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by ranging from mild to severe and which continues beyond the expected healing phase.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000836"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensation perception that is characterized by an increased response to a painful stimulus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000835"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensation perception that is characterized by a diminished sensitivity to painful stimulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000834"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensation perception that is characterized by a reduced sense of touch or sensation, or a partial loss of sensitivity to sensory stimuli.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Hypoesthesia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000833"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by originating from organ tissues of the thorax, abdomen, or pelvis.  It characterizes as deep, vague, and difficult to locate pain, that radiates away from the affected organ.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000832"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by being experienced by cancer patients and which is caused by radiotherapy or chemotherapy damage to nerves, when cancer invades or compresses nerves, or when, during cancer treatment. This type of pain is typically described as burning, electrical, or strange feeling.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000831"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by originating from other than the peripheral and central nervous systems, and which is caused by activation of nociceptive fibers.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000830"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a painful sensation that is perceived to originate in the amputated portion of the extremety. Patients may have localized pain that originates in the stump.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000829"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by an unpleasant sensation localized in the neck that usually indicates the body is threatened or damaged. The sensation may be sharp or dull, short-lived or chronic, intermittent or continual.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000828"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sore eyes is a eye symptom characterized by an inflammation of the thin covering of the eyeball and the inner eyelid brought about by a viral infection which may be highly contagious.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.doh.gov.ph/faqs/sore_eyes</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000827"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tachycardia that is associated with the generation of improper electrical impulses within the ventricles, characterized by an electrocardiogram showing a rate of greater than 120 BPM and three or more wide QRS complexes in a row.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Ventricular_tachycardia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000826"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sinus tachycardia is a tachychardia characterized by an abnormally rapid sinus rhythm specifically a sinus rhythm at a rate greater than 100 beats per minute.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sinus%20tachycardia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000825"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paroxysmal tachycardia is a tachycardia that begins and ends abruptly and that is initiated by a premature supraventricular beat originating in the atrium or in the atrioventricular node or bundle of His or by a premature ventricular beat.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=paroxysmal%20tachycardia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000824"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Junctional tachycardia is a tachycardia associated with the generation of impulses in a locus in the region of the atrioventricular node.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=junctional%20tachycardia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000823"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sinus bradycardia is a bradycardia where the sinus rhythm is abnormally slow bradycardia consisting of a sinus rhythm at a rate lower than 60 beats per minute.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sinus%20bradycardia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000822"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chronic enteritis is a enteritis with slow progress, long duration, or frequent recurrence which can be due to Crohn's disease, giardiasis, tuberculosis, coeliac disease, or rarely due to Whipple's disease.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Enteritis</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.rootsweb.ancestry.com/~vapage2/deathcauses.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000768"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a pain in, or about, a testis (testicle) or testes. Testicular pain can be caused by nerve damage, sexually transmitted infections, gangrene, swelling, hernia, kidney stones, inflammation, enlarged veins, fluid in the testicle, or a severe condition known as testicular torsion.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/testicle-pain</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000764"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a pain situated, or occurring, behind the eyeball.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/medical/retrobulbar</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000760"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a minute reddish or purplish spot containing blood that appears in skin or mucous membrane as a result of localized hemorrhage.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=petechiae</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000759"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a pain situated, or occurring, in the parotid gland, which is a salivary gland located in front of the ears. (Additional salivary glands include the submandibular and sublingual glands.) Pain is attributed to swelling of the gland.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Parotid_gland</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Salivary_gland</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://myhealth.alberta.ca/Health/aftercareinformation/pages/conditions.aspx?hwid=zp4169</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000756"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized an abnormally profuse menstrual flow.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=menorrhagia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000748"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An edema that is characterized by an abnormal excess accumulation of serous fluid in connective tissue of the face.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://angletoner.com/facial-swelling/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000746"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an eruption on a mucous surface.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=enanthem</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000742"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gum bleeding is a mouth symptom characterized by a copious discharge of blood from the blood vessels of the mucosal tissue that lies over the alveolar bone.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Gingival</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hemorrhage</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000739"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by bleeding (hemorrhage) in either or both the bronchi and the lungs.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/medical/bronchopulmonary</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000737"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by an ulceration (dying and sloughing) of the bronchial or bronchiolar epithelium, exposing the underlying basement membrane.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/respiratory+mucosa</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://ntp.niehs.nih.gov/nnl/respiratory/lung/ulcer/index.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000735"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pneumonia that is characterized by the formation of pus and destruction of pulmonary tissue; abscess formation may occur.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/suppurative+pneumonia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000734"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by a sudden diminution or loss of consciousness, sensation, and voluntary motion caused by rupture or obstruction (as by a clot) of a blood vessel of the brain.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=stroke</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000731"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by a loss of excretory function in one or both kidneys, leading to retention of nitrogenous waste products from the blood.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK519012/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000730"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by an increased breathing rate, with more than 20 breaths per minute in an adult, while in children, the number of breaths per minute can be a higher resting rate than seen in adults.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/rapid-shallow-breathing#What-is-tachypnea?</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000729"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by a region of normally compressible lung tissue that has filled with liquid instead of air.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Pulmonary_consolidation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000719"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a diminished or reduced ability to remember things such as dates and names, and increased forgetfulness.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/impairment</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000718"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a state in which an individual lacks normal awareness of self and the surrounding environment and one's ability to remain awake, aware, and oriented is impaired.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://drwilderman.com/neurological-disorders/loss-of-consciousness/</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/consciousness-decreased</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000715"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by the peeling off of skin in the form of scales.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=desquamation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000712"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized the biological inability of a man or a woman to contribute to conception; or, the state of a woman who is unable to carry a pregnancy to full term.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Infertility</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000705"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aphasia that is characterized by damage to, or a developmental issues in, the anterior regions of the brain, including (but not limited to) the left inferior frontal region known as Broca's area. Sufferers of this form of aphasia exhibit the common problem of agrammatism. For them, speech is difficult to initiate, non-fluent, labored, and halting.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Expressive_aphasia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000698"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A feeding difficulties and mismanagement that is characterized by a decrease in muscle coordination to form a suck response so that the child can ingest milk.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://adoption.umn.edu/sucking-problems</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000695"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by a decrease in the production of milk in breastfeeding mothers.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.chop.edu/pages/low-milk-supply</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.thewomens.org.au/health-information/breastfeeding/breastfeeding-problems/low-milk-supply</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000688"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abnormal involuntary movement that is characterized by an inability to walk in a straight line.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3434216/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000687"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Chronic fatigue syndrome is a fatigue characterized by a disorder of uncertain cause that is characterized by persistent profound fatigue usually accompanied by impairment in short-term memory or concentration, sore throat, tender lymph nodes, muscle or joint pain, and headache unrelated to any preexisting medical condition and that typically has an onset at about 30 years of age.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=chronic%20fatigue%20syndrome</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000686"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cough that is characterized by an explosive expulsion of air from the lungs acting as a protective mechanism to clear the air passages or as a symptom of pulmonary disturbance marked by long duration, by frequent recurrence over a long time, and often by slowly progressing seriousness.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=chronic</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000683"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tachypnoea is a respiratory system and chest symptom characterized by an increased rate of respiration.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=tachypnoea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000682"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by a host of presentations that include changes in cognition, mood, behavior, and/or level of arousal.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.hopkinsguides.com/hopkins/view/Johns_Hopkins_Psychiatry_Guide/787028/all/Altered_Mental_Status</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000681"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A behavioral symptom that is characterized by behavior aimed at harming a person, or animal, or damaging physical property.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/aggressive-behavior</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000680"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight loss that is characterized by a severe and sudden onset.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/imagepages/18126.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000679"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dyspnea that is characterized by a severe and sudden onset.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/imagepages/18126.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000678"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by a severe and sudden onset of disturbance in the normal operation of one's cognition, emotional regulation, or behaviour.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.who.int/news-room/fact-sheets/detail/mental-disorders</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000676"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acute enteritis is a enteritis with either or both a rapid onset and a short course which is usually due to bacteria or virus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Acute_%28medicine%29</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Enteritis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000675"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acute diarrhea is a diarrhea with either or both a rapid onset or a short course.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Acute_%28medicine%29</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=diarrhea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000673"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bradykinesia is a hypokinesia characterized by an extreme slowness in the execution of movements and reflexes.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Bradykinesia</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=bradykinesia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000666"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A behavioral symptom that is characterized by behavior that is atypical or statistically uncommon within a particular culture, or that is maladaptive, or detrimental to an individual, or those around that individual.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.betterhelp.com/advice/behavior/what-is-abnormal-behavior/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000662"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Shakes is a general symptom characterized by a condition of trembling.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=shakes</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000660"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rash characterized by a red or purple hued small spots of blood appear on the skin caused by conditions that result in blood leaking into the skin and other body surfaces that does not fade when pressed upon.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Purpura</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://patient.info/allergies-blood-immune/blood-clotting-tests/purpuric-rashes</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000659"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paralysis that is charachterized by a slight or partial paralysis.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=pareses</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000654"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A behavioral symptom that is characterized by a quick excitability to annoyance, impatience, or anger.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=irritability</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000647"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin ulcer that is characterized by a a small dark-centered ulcer that appears at the site of a tick bite and is the primary lesion of boutonneuse fever.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=tache%20noire</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000646"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Synovitis is a joint inflammation characterized by an inflammation of a synovial membrane usually with pain and swelling of the joint.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=synovitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000643"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by a difficulty to breathe on one's own and develops when the lungs cannot get enough oxygen into the blood.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nhlbi.nih.gov/health/respiratory-failure</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000640"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rash characterized by an inflammatory reaction of the skin on the ankles.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthgrades.com/right-care/skin-hair-and-nails/ankle-rash</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000638"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rash characterized by papule(s), which are a raised area of the skin.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/skin-problems-and-treatments/what-is-maculopapular-rash</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000636"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rash characterized by papule(s), which are a raised area of the skin and macule(s), which are a flat red area of the skin.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/skin-problems-and-treatments/what-is-maculopapular-rash</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000632"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A joint pain that is characterized by a pain situated, or occurring, in or around the hip.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003179.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000629"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rash characterized by a widespread skin eruption usually occurring in children that is a symptom of a more general disease.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Exanthema</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000625"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of consciousness that is characterized by a disturbance in sentience (the ability to experience feelings and sensations) or awareness of one's internal and external existence, i.e. inhibited or absent self-awareness.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Consciousness</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Disorders_of_consciousness</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000621"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aphasia that is characterized by a loss of ability to read.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=alexia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000620"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abdominal pain that is characterized by occurring in the left lower quadrant of the abdomen that is often related to the digestive tract, but can also be related to conditions of the body wall, skin, blood vessels, urinary tract, or reproductive organs.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthgrades.com/right-care/symptoms-and-conditions/left-lower-quadrant-pain</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000614"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by an explosive expulsion of air from the lungs acting as a protective mechanism to clear the air passages or as a symptom of pulmonary disturbance.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=cough</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000613"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a rise of body temperature above the normal, whether as a natural response (as to infection) or artificially induced for therapeutic reasons.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=fever</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000610"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A  balance symptom that is characterized by a sensation of unsteadiness accompanied by a feeling of movement within the head.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=dizziness</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000609"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by excessive sweating, i.e. the production of more sweat than is required to regulate body temperature.  Generalized hyperhidrosis is caused by non-thermoregulatory stimuli and affects the entire body.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://sydneynorthneurology.com.au/generalised-hyperhidrosis/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000608"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of consciousness that is characterized by a loss of consciousness resulting from insufficient blood flow to the brain and limb weakness progressing to collapse.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Syncope_(medicine)</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000607"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hallucination is a general symptom where there is a perception of something (as a visual image or a sound) with no external cause usually arising from a disorder of the nervous system (as in delirium tremens or in functional psychosis without known neurological disease) or in response to drugs (as LSD).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hallucinations</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000606"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary incontinence that is characterized by involuntary urination at night in children five years of age or older.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3348193/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000605"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of consciousness that is characterized by a deep state of prolonged unconsciousness in which a person cannot be awakened, fails to respond normally to painful stimuli, light, or sound, lacks a normal wake-sleep cycle and does not initiate voluntary actions.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Coma</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000604"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abnormal chest sound that is characterized by breathing with difficulty usually with a whistling sound.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=wheezing</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000603"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by an increased rate of respiration and shallow breathing.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=tachypnea</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/rapid-shallow-breathing</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000602"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by a difficulty in breathing that occurs when lying down and is relieved upon changing to an upright position (as in congestive heart failure).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=orthopnea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000601"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by excessive ventilation characterized by excessive rate and depth of respiration leading to abnormal loss of carbon dioxide from the blood.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hyperventilation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000600"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by transient cessation of respiration whether normal (as in hibernating animals) or abnormal (as that caused by certain drugs).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=apnea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000599"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by a specific form of periodic breathing (waxing and waning amplitude of flow or tidal volume) characterized by a crescendo-decrescendo pattern of respiration between central apneas or central hypopneas.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK448165/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000598"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by a respiration that is not normal and may include, but is not limited to: apnea, eupnea, orthopnea, dyspnea hyperpnea, hyperventilation, hypoventilation, tachypnea, Kussmaul respiration, Cheyne-Stokes respiration, sighing respiration, Biot respiration, apneustic breathing, central neurogenic hyperventilation, and central neurogenic hypoventilation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK470309/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000596"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by an abnormal violent and involuntary contraction or series of contractions of the muscles.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/convulsion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000595"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A convulsion that is characterized by occurring in young children between six months and five years of age and which is triggered by fever.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ninds.nih.gov/febrile-seizures-fact-sheet</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/a-to-z-guides/swollen-glands</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000594"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by an inability to control bodily movement and may be a symptom of cerebrovascular diseases, dyskinesia, tremor, chorea, dystonia and myoclonus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://patient.info/doctor/abnormal-involuntary-movements</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://stanfordmedicine25.stanford.edu/the25/involuntary-movements-and-tremors.html</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000590"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by a strong and immediate need to urinate due to an increase in pressure in the bladder, resulting in difficulty to hold in the urine. This can occur regardless of whether the bladder is full.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.medicalnewstoday.com/articles/325336#symptoms</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000589"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary stream symptom that is characterized by a slow or weak stream of urine.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.besturologistnyc.com/what-is-slow-urine-flow</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000588"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by an injury of the urethra in its bulbous or membranous portion, which leads to a collection of urine in other cavities, such as the perineal space, the scrotum, the penis and the connective tissue of the anterior abdominal wall.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Extravasation_of_urine</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://jamanetwork.com/journals/jama/article-abstract/466994</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000587"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by a sound of breathing that is not similar to that of the sound of moving air and may include: rhonchi (a low-pitched breath sound), crackles (a high-pitched breath sound), wheezing (a high-pitched whistling sound caused by narrowing of the bronchial tubes), and stridor (a harsh, vibratory sound caused by narrowing of the upper airway).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/breath-sounds#types</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000586"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary incontinence that is characterized by a bladder that does not empty completely, resulting in a bladder that is too full, which leads to overflow and unexpected leaking.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.health.harvard.edu/bladder-and-bowel/types-of-urinary-incontinence</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/overactive-bladder/overflow-incontinence</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/urinary-incontinence-oab/overflow-incontinence</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000582"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hypersomnia is a sleep disturbance characterized by sleeping for excessive periods at intervals with intervening periods of normal duration of sleeping and waking.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hypersomnia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000581"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An apnea that is characterized by brief periods of recurrent cessation of breathing during sleep that is caused especially by obstruction of the airway or a disturbance in the brain's respiratory center and is associated especially with excessive daytime sleepiness.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sleep%20apnea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000572"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary stream symptom that is characterized by a split in the urine flow resulting in it streaming in two directions.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://ugatl.com/services/prostatitis/splitting-urine-stream/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000571"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Insomnia is a sleep disturbance characterized by prolonged and usually abnormal inability to obtain adequate sleep.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=insomnia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000570"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diarrhea is a feces and droppng symptom involving the abnormally frequent intestinal evacuations with more or less fluid stools.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=diarrhea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000569"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by the reduced excretion of urine.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=oliguria</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000568"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lack of expected normal physiological development in childhood that is characterized by an individual's height being in the 3rd percentile for the mean height of a given age, sex, and population group.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK556031/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000565"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by the excessive secretion of urine.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=polyuria</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000564"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by urination at night especially when excessive.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=nocturia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000563"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by the need to urinate many times during the day, at night, or both but in normal or less-than-normal volumes.  Frequency may be accompanied by a sensation of an urgent need to void (urgency of urination).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merckmanuals.com/professional/genitourinary-disorders/symptoms-of-genitourinary-disorders/urinary-frequency</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000560"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by an excessive or abnormal thirst.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=polydipsia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000557"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by an inability to empty the bladder completely during the process of voiding (urination).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Urinary_retention</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000552"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by a state of meningeal irritation with symptoms suggesting meningitis that often occurs at the onset of acute febrile diseases especially in children.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=meningismus</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000544"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paralysis that is characterized by a loss of some, or all, muscle control in a limb, and which lasts for only a short time (i.e. is temporary).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://dictionary.cambridge.org/us/dictionary/english/transient</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.spinalcord.com/blog/what-causes-temporary-paralysis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000543"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by an unusual forgetfulness. One may not be able to remember new events, recall one or more memories of the past, or both.  Memory loss may be for a short time and then resolve (transient), or it may not go away and get worse over time.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003257.htm</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merckmanuals.com/professional/neurologic-disorders/symptoms-of-neurologic-disorders/memory-loss</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000542"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abdominal pain that is characterized by occurring in the epigastrium, i.e. the upper part of the abdomen below the rib cage.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://info.isabelhealthcare.com/blog/why-does-my-stomach-hurt-epigastric-pain-symptoms-and-causes</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/epigastric-pain</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000540"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by a feeling of discomfort when breathing in or out.  The pain may be the result of infection, musculoskeletal injury, and heart problems.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/painful-respiration#causes</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.medicalnewstoday.com/articles/324718</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000539"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a yellowish pigmentation of the skin, tissues, and certain body fluids is caused by the deposition of bile pigments that follows interference with normal production and discharge of bile (as in certain liver diseases) or excessive breakdown of red blood cells (as after internal hemorrhage or in various hemolytic states).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=jaundice</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000538"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an abnormal excess accumulation of serous fluid in connective tissue or in a serous cavity.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=edema</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000537"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a bluish or purplish discoloration (as of skin) due to deficient oxygenation of the blood.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=cyanosis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000534"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by the spontaneous escape of blood into the tissues from ruptured blood vessels marked by a livid black-and-blue or purple spot or area.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=ecchymoses</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000533"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary incontinence that is characterized by urine remaining in the urethra after voiding the bladder that slowly leaks out after urination.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Post-void_dribbling</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000532"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary incontinence that is characterized by an involuntary leakage of urine from the bladder when a sudden strong need to urinate is felt, even when the bladder isn't full.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=urge%20incontinence</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.health.harvard.edu/bladder-and-bowel/types-of-urinary-incontinence</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000530"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Palpitation is a cardiovascykar system symptom characterized by an abnormal awareness of the beating of the heart,whether it is too slow, too fast, irregular, or at its normal frequency when excited by violent exertion, strong emotion, or disease.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Palpitation</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=palpitation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000529"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tachycardia is a cardiovascular system symptom consisting of a relatively rapid heart action whether physiological (as after exercise) or pathological.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=tachycardia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000526"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abdominal symptom consisting of an abnormal accumulation of serous fluid in the spaces between tissues and organs in the cavity of the abdomen.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=ascites</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000525"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of consciousness that is characterized by a brief (transient) episode of losing normal awareness or behavior.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.inst-neuro.com/services/epilepsy/transient-alteration-of-awareness/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000524"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by an excessive appetite or eating.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=polyphagia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000523"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by a loss of appetite especially when prolonged.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=anorexia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000518"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abdominal pain that is characterized by being diffuse or widespread and affecting or involving all of the abdomen.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/generalization</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/generalized</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000517"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by an expectoration of blood from some part of the respiratory tract.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hemoptysis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000515"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by a spasmodic inhalation with closure of the glottis accompanied by a peculiar sound.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hiccough</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000513"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abnormal chest sound that is characterized by a harsh vibrating sound heard during respiration in cases of obstruction of the air passages.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=stridor</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000512"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A stress incontinence that is characterized by a compromised external urinary sphincter muscle resulting from surgical or radiotherapeutic manipulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC3356867/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000511"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a markedly red flush in a persons face and often other areas of the skin, from various physiological conditions. Flushing is generally distinguished, despite a close physiological relation between them, from blushing, which is milder, generally restricted to the face or cheeks, and generally assumed to reflect embarrassment. Flushing is also a cardinal symptom of carcinoid syndrome the syndrome that results from hormones (often serotonin or histamine) being secreted into systemic circulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Flushing_%28physiology%29</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000510"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a deficiency of color especially of the face.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=pallor</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000508"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by a loss or impairment of the power to use or comprehend words usually resulting from brain damage.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=aphasia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000505"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a painful throat due to inflammation of the fauces and pharynx.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sore%20throat</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000504"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a pain in the head.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=headache</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000503"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by a physical decline in health seen in older adults – typically those with multiple chronic medical conditions – resulting in decreased appetite and poor nutrition, weight loss, inactivity, often accompanied by dehydration, depression, decreasing functional ability, and impaired immune function.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.compassus.com/for-caregivers/what-is-adult-failure-to-thrive</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.uptodate.com/contents/failure-to-thrive-in-older-adults-evaluation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000502"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary incontinence that is characterized by urine leakage when you sneeze, cough, laugh, do jarring exercise, or lift something heavy. It is typically a combination of stress and urge incontinence.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.health.harvard.edu/bladder-and-bowel/types-of-urinary-incontinence</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/urinary-incontinence-oab/mixed-incontinence</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000495"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by abnormal purulent or mucoid secretions from the penis or, rarely, the female urethra.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://accessmedicine.mhmedical.com/content.aspx?bookid=369&amp;sectionid=39914779#:~:text=Urethral%20discharge%20is%20characterized%20by,of%20leukorrhea%20and%20urethral%20inflammation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000494"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A colic that is characterized by a severe pain produced by the passage of a calculus from the kidney through the ureter.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=renal%20colic</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000492"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by the an inability of the body to control the evacuative functions.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=incontinence</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000488"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by the outer layer of the skin starting to replace itself. Often, this happens when skin is damaged, either by disease or injury.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.medicinenet.com/peeling_skin/symptoms.htm</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/skin-problems-and-treatments/what-know-about-peeling-skin-desquamation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000487"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an eruption on the body typically with little or no elevation above the surface.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=rash</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000485"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by the difficult, or painful, discharge of urine.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=dysuria</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000482"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by any condition which is significantly different from a normal waking state.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Altered_state_of_consciousness</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000481"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of consciousness that is characterized by an individual with severe brain damage being in a state of partial arousal rather than true awareness. After four weeks in a vegetative state, the patient is classified as being in a persistent vegetative state. After three months in the US and six months in the UK, the diagnosis is classified as a permanent vegetative state after a non-traumatic brain injury, or, one year after a traumatic injury.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Persistent_vegetative_state</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000479"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abnormality of gait is a nervous system and musculoskeletal system symptom characterized by a difficulty in the manner of walking or moving on foot.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/dictionary/gait</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000475"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight symptom that is characterized by weighing less than the normal amount for one's age, height, and build.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/underweight</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000472"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by a feeling of being full after a few bites of food, or before you finish a normal-sized meal.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/satiety-early</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000466"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lack of expected normal physiological development in childhood that is characterized by a failure for a child to reach a significant stage at the predicted age and may include walking or talking.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Delayed_milestone</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000465"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lack of expected normal physiological development in childhood that is characterized by a decelerated or arrested physical growth (height and weight measurements fall below the third or fifth percentile, or a downward change in growth across two major growth percentiles) and is associated with abnormal growth and development.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.chop.edu/conditions-diseases/failure-thrive</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000462"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A symptom is a perceived change in function, sensation, loss, disturbance or appearance reported by a patient indicative of a disease.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://link.springer.com/chapter/10.1007/978-1-4615-4789-1_5</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/symptom</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nature.com/subjects/signs-and-symptoms</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000458"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nausea is a digestive system symptom characterized by an uneasy or unsettled feeling in the stomach together with an urge to vomit.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nlm.nih.gov/medlineplus/nauseaandvomiting.html</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000457"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by occurring in the abdomen, i.e. between the chest and groin.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003120.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000456"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abdominal pain that is characterized by occurring in the left upper quadrant abdominal pain of the abdomen that can be caused by a stomach ulcer, acute gastritis, a viral infection, or indigestion, or may be an issue with one's lungs.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.buoyhealth.com/learn/pain-upper-left-abdomen</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000455"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight gain that is characterized as deviating from what is normal or usual, typically in a way that is undesirable or worrying.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/abnormal</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000450"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cardiovascular system symptom that is characterized as a state of profound depression of the vital processes of the body that is characterized by pallor, rapid but weak pulse, rapid and shallow respiration, reduced total blood volume, and low blood pressure and that is caused usually by severe especially crushing injuries, hemorrhage, burns, or major surgery.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/medlineplus/shock</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000448"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nose symptom that involves a is loss of blood from the tissue lining the nose.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nlm.nih.gov/medlineplus/ency/article/003106.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000447"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sputum that is characterized by blood or bloody mucus discharged from the air passages caused by common forms of infection in the lungs and airways, such as acute bronchitis or pneumonia. Bloody sputum can also come from cancer of the lung.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.medicinenet.com/symptoms_and_signs/article.htm</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sputum</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000445"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Faint is a alteration of consciousness characterized by a loss of consciousness because of a temporary decrease in the blood supply to the brain.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/dictionary/fainting</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000443"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A joint pain that is characterized by a pain situated, or occurring, in or around the shoulder.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003171.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000442"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A joint pain that is characterized by a pain situated, or occurring, in or around the knee.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003187.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000441"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A joint pain that is characterized by a pain situated, or occurring, in or around the elbow.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003172.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000440"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A hair symptom that is characterized by the stopping of hair growth (regeneration), which may be a result of hereditary hair loss, immune system overreacts, drugs and treatments, harsh hair-care products, and other factors.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.aad.org/public/diseases/hair-loss/insider/shedding</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000439"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heartburn is a pain characterized by a painful burning feeling in your chest or throat that happens when stomach acid backs up into your esophagus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nlm.nih.gov/medlineplus/heartburn.html</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000438"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a pain in, or about, a tooth or teeth.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/toothache</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000436"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by bleeding from the uterus that is longer than usual or that occurs at an irregular time. Bleeding may be heavier or lighter than usual and occur often or randomly.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/000903.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000435"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a sensation of pricking, tingling, or creeping on the skin having no objective cause and usually associated with injury or irritation of a sensory nerve or nerve root.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=paresthesia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000434"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by raised red skin wheals (welts) commonly caused by an allergic reaction with wheals that may vary in size from about 5 mm (0.2 inches) in diameter to the size of a dinner plate that are described as severely itchy a stingnig or burning sensation, and having a pale border.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Urticaria</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000433"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An edema characterized as generalized edema with accumulation of serum in the connective tissue.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=anasarca</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000432"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an uneasy irritating sensation in the upper surface of the skin usually held to result from mild stimulation of pain receptors.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=itching</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000431"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by matter discharged from the air passages in diseases of the lungs, bronchi, or upper respiratory tract that contains mucus and often pus, blood, fibrin, or bacterial products.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sputum</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000430"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chest pain that is characterized by an inflammation of the pleural cavity with a sharp pain resulting from the exansion of the lungs as the inflammed pleural layers rub against each other.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Pleuritic_chest_pain</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=pleurisy</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000429"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by abnormally slow breathing.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=bradypnea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000428"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by a deficient ventilation of the lungs that results in reduction in the oxygen content or increase in the carbon dioxide content of the blood or both.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hypoventilation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000427"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by an abnormal physical or psychological state of a male characterized by inability to copulate because of failure to have, or maintain, an erection.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=impotence</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000424"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a leg pain in the calf, or thigh, which is caused by inadequate blood flow to the leg muscles and is brought on by leg exercise such as walking.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nature.com/nrd/journal/v2/n1/glossary/nrd985_glossary.html</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.vasculardoc.net/content/glossary.html</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000423"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From synonym: Heartburn is a pain characterized by a painful burning feeling in your chest or throat that happens when stomach acid backs up into your esophagus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/heartburn.html</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000422"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dyspepsia is a digestive system symptom referred to as indigestion resulting from an impairment to digestion caused by ulcer, gall bladder disease or inflamed colon. Related symptoms include weakness, loss of appetite, and depression.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.rootsweb.ancestry.com/~vapage2/deathcauses.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000421"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hematochezia is a feces and droppings symptom characterized by the passage of fresh blood per anus, usually in or with stools.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK411/#A2794</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000420"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bloating is a digestive system symptom involving the accumulation of gas in the digestive tract and resulting in abdominal distension.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=bloating</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000414"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a difficulty in articulating words due to disease of the central nervous system.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=dysarthria</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000413"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a marked psychomotor disturbance that may involve stupor or mutism, negativism, rigidity, purposeless excitement, echolalia, echopraxia, and inappropriate or bizarre posturing and is associated with various medical conditions (as schizophrenia and mood disorders).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=catatonia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000412"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a painful or apprehensive uneasiness of mind usually over an impending or anticipated ill.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=anxiety</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000409"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A high fever that is characterized by an exceptionally high fever especially when induced artificially for therapeutic purposes.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hyperthermia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000408"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cataplexy is a muscle symptom characterized by a sudden loss of muscle control with retention of clear consciousness that follows a strong emotional stimulus (as elation, surprise, or anger) and is a characteristic symptom of narcolepsy.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=cataplexy</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000407"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of consciousness that is characterized by a loss of consciousness resulting from insufficient blood flow to the brain.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Syncope_(medicine)</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/fainting</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/syncope</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000406"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an injury transmitted through unbroken skin to underlying tissue causing rupture of small blood vessels and escape of blood into the tissue with resulting discoloration.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=bruise</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000405"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by a painful spasmodic contraction of the vagina.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=vaginismus</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000403"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight symptom that is characterized by an increase in body weight. This can involve an increase in muscle mass, fat deposits, excess fluids such as water or other factors.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Weight_gain#</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000402"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by a general physical wasting and malnutrition usually associated with chronic disease.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=cachexia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000399"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dizziness that is characterized by a specific type of dizziness, a major symptom of a balance disorder. It is the sensation of spinning or swaying while the body is stationary with respect to the surroundings.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Vertigo_%28medical%29</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000398"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by fluid made by glands inside the vagina and cervix carrying away dead cells and bacteria. While it is normal for odor and color to vary, vaginal itching or burning may be indicative of an infection.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merckmanuals.com/professional/gynecology-and-obstetrics/symptoms-of-gynecologic-disorders/vaginal-bleeding</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/women/guide/vaginal-discharge-whats-abnormal</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000389"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of consciousness that is characterized by a lack of critical mental function and a level of consciousness, in which an affected person is almost entirely unresponsive and responds only to intense stimuli such as pain.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Stupor</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000379"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A muscle pain that is characterized by being severe in nature.  Myalgia may be acute in nature, stemming from overuse of a muscle group or viral infection.  It may also be chronic and caused by  metabolic myopathy, some nutritional deficiencies, and chronic fatigue syndrome.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Myalgia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000378"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A mastitis that is characterized by an increased intensity or severity of the condition.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/severe</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000377"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an inflammation of the mammary gland or udder and usually caused by infection.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=mastitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000374"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by an abscess that is either superficial or intrascrotal.  Superficial scrotal abscess may occur from an infected hair follicle, infection of a scrotal laceration, or minor scrotal surgery.  Intrascrotal abscess most commonly arises from bacterial epididymitis, but may also be related to tuberculous infection of the epididymis, a testicular abscess that ruptures through the tunica albuginea, or drainage of appendicitis into scrotum through a patent processus vaginalis or as a result of extravasation of infected urine from the urethra in patients with a urethral stricture and neurogenic bladder using an external collection device.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://emedicine.medscape.com/article/1949750-overview</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000372"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nose symptom that is characterized by an excessive secretion of mucous through the nose.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=Rhinorrhea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000371"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paralysis that is characterized by a complete or severe weakness of the muscles of respiration.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/mesh/68012133</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000370"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by a pocket (a walled-off cavity) of pus that develops in the kidney tissue. It results from the migration of bacteria from another infection site on the body to the kidneys.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.uptodate.com/contents/renal-and-perinephric-abscess</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000369"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ptosis is a general symptom characterized by a sagging or prolapse of an organ or part.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=ptosis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000367"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom characterized by the presence of excess protein in the urine.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=proteinuria</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000366"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prostate symptom that is characterized by inflammation of the prostate and surrounding area.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/prostate-infection#</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000365"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A prostate symptom that is characterized by a localized collection of purulent fluid within the prostate, often forming as a complication of acute bacterial prostatitis.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK551663/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000361"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An emaciation that is characterized by an increase in scope or severity with time.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.rxlist.com/progressive/definition.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000360"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A wasting that is characterized by the state of being extremely thin as a result of an absence of body fat and very week as a result of muscle wasting; usually because of illness or extreme hunger.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://dictionary.cambridge.org/us/dictionary/english/emaciation</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Emaciation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000358"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by labor occurring before 37 full weeks of pregnancy.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.ehealthmd.com/library/amniocentesis/AMO_glossary.html</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000355"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A feeding difficulties and mismanagement that is characterized by an infant with little interest in feeding and it can also refer to an infant who is not feeding enough to receive the necessary nutrition required for adequate growth.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/poor-feeding-in-infants</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000354"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by an inflammation of lung tissue. Pneumonia is one type of pneumonitis caused by an infection. Many other factors can cause pneumonitis, including breathing in animal dander, inhaling small food particles 'down the wrong pipe' and receiving radiation therapy to your chest.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Pneumonitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000353"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by a viscid mucus secreted in abnormal quantity in the respiratory passages.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=phlegm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000349"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paralysis that is characterized by a complete, or partial, loss of function of the lower half of the body with involvement of both legs that is usually due to injury or disease of the spinal cord in the thoracic or lumbar region.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/paraplegia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000346"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a small solid usually conical elevation of the skin caused by inflammation, accumulated secretion, or hypertrophy of tissue elements.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=papule</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000345"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by short, shallow, and rapid breathing.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/panting</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000344"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An edema that is characterized by an abnormal excess accumulation of serous fluid in connective tissue of the eyelids.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://scopeheal.com/palpebral-edema/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000343"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a pain situated, or occurring, in the lymph gland (lymph node). Pain is often associated with swelling of the gland, which is a sign that one's body is fighting an infection.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Lymph_node</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nhs.uk/conditions/swollen-glands/</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/a-to-z-guides/swollen-glands</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000340"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An edema that is characterized by an abnormal excess accumulation of serous fluid in connective tissue of the limbs.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7536506/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000331"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a continuous or prolonged dull pain.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/ache</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000328"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A tetanic convulsion that is not intense (not severe).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.macmillandictionary.com/us/dictionary/american/mild_1</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000327"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A convulsion that is characterized by a tonic spasm (prolonged contraction of the muscles), without loss of consciousness and often associated with hypocalcemia.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/tetanic</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000324"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by an acute or chronic inflammation of the bronchial tubes.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=bronchitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000323"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A feces and droppings symptom that is characterized by the passage of dark tarry stools containing decomposing blood that is usually an indication of bleeding in the upper part of the alimentary canal and especially the esophagus, stomach, and duodenum.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/medlineplus/melena</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000322"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight symptom that is characterized by an infant weighing 5.5 pounds (2500 grams) or less at birth.  Low birth weight may occur with premature birth, or due to smoking cigarettes, secondhand tobacco smoke exposure, drinking alcohol, and taking certain drugs during pregnancy.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.cancer.gov/publications/dictionaries/cancer-terms/def/low-birth-weight</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000318"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A  balance symptom that is characterized by an inability to stay upright and move confidently.  Loss of balance may be due to problems in the inner ear, the brain, or the heart. Aging, infections, head injury, certain medicines, and problems with blood circulation may also cause balance problems.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/balanceproblems.html</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nidcd.nih.gov/health/balance-disorders</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000309"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of appetite that is characterized by a loss of desire to eat, i.e. no desire to eat.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merckmanuals.com/home/digestive-disorders/symptoms-of-digestive-disorders/loss-of-appetite</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000306"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A feeding difficulties and mismanagement that is characterized by a lack of feeding capacity.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2851259/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000304"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A coordination symptom that is characterized by weakened or imperfect body complicated  movement, which may be caused by disease, injury, or toxins.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/movement-uncoordinated</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merckmanuals.com/home/brain,-spinal-cord,-and-nerve-disorders/movement-disorders/coordination-disorders</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000302"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a subnormal temperature of the body, as defined by a temperature under 36.6 degrees Celcius (97.8 degrees Fahrenheit).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hypothermia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000300"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensation perception that is characterized by an increased sensitivity to stimulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000299"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hyperemia is a hemic system symptom consisting of an excess of blood in a body part as from an increased flow of blood due to vasodilation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hyperemia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000295"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hepatic abscess is a liver symptom characterized by a pus-filled mass in the liver that can develop from injury to the liver or an intraabdominal infection disseminated from the portal circulation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK538230/#:~:text=A%20liver%20abscess%20is%20defined,caused%20by%20parasites%20and%20fungi.</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000293"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paralysis that is characterized by a weakness or the inability to move on one side of the body.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.stroke.org/en/about-stroke/effects-of-stroke/physical-effects-of-stroke/physical-impact/hemiparesis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000290"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Belching is a digestive system symptom involving the sudden expulsion of gas from the stomach through the mouth.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=belching</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000289"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an inflammatory condition of the skin with redness, itching, and oozing vesicular lesions, which become scaly, crusted, or hardened.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=eczema</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000287"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arrhythmia is a cardiovascular system symptom consisting of an alteration in rhythm of the heartbeat either in time or force.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=arrhythmia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000285"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A paralysis that is charicterized by a lack of muscle tone in the affected muscles and in which tendon reflexes are decreased or absent.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=flaccid%20paralysis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000280"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fatigue that is characterized by exceeding the ordinary, usual, or expected.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/extreme</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000279"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An exhaustion that is characterized by exceeding the ordinary, usual, or expected.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/extreme</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000264"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by inflammation of the epididymis and/or testicle (testis).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://patient.info/mens-health/scrotal-lumps-pain-and-swelling/epididymo-orchitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000263"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by an inflammation of the epididymis.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=epididymitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000259"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dry cough that is characterized by a rough and loud sound.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wiktionary.org/wiki/hacking_cough</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000252"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A rash characterized by large patches of red skin, without overlying changes in the epidermis.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.drugwatch.com/health/rash-and-skin-disorders/erythema/</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.sciencedirect.com/topics/medicine-and-dentistry/erythema</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000251"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a pus-filled pocket in the skin, similar to a pimple, but larger and deeper.  The pocket is filled with bacteria, white blood cells, and dead skin and typcally result from the bacteria Staphylococcus aureus prentrating the skin through a cut or hair follicle.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://jamanetwork.com/journals/jama/fullarticle/2677448</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000248"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A proprioception symptom that is characterized by a decreased ability of an organism to consciously process the reception of stimuli produced within the organism.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=proprioception</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000247"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by one's body’s ability to sense movement, action, and location and results from sensory receptors in one's nervous system and body (muscles, joints, and tendons).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/brain/what-is-proprioception</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000246"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of appetite that is characterized by an desire to eat, an excess desire for food.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003134.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000245"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An alteration of appetite that is characterized by a reduced desire to eat.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/appetite-decreased</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000243"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by occurring during periodic episodes.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Fever#Types</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.wrongdiagnosis.com/sym/cyclic_fever_in_children.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000242"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cough that is characterized by production and expectoration (bringing up) of sputum that is bright red or pink and frothy.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.webmd.com/lung/coughing-up-blood</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000237"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by an excessive accumulation especially of blood or mucus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=congestion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000236"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by an attack of acute abdominal pain localized in a hollow organ or part (as the small intestine, ureter, or bile duct) and often caused by spasm, obstruction, or twisting.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=colic</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000235"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by the condition marked by recurrent episodes of prolonged and uncontrollable crying and irritability in an otherwise healthy infant that is of unknown cause and usually subsides after three to four months of age.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=colic</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000232"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by an inflammation of the bronchioles.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=bronchiolitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000231"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bradycardia is a cardiovascular system symptom consisting of a relatively slow heart action whether physiological or pathological.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=bradycardia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000226"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cardiac fibrillation consisting of a very rapid uncoordinated contractions of the atria of the heart resulting in a lack of synchronism between heartbeat and pulse beat.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=atrial%20fibrillation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000219"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An inability to comprehend speech that is characterized by an inability to understand spoken, written, or tactile speech symbols that results from damage (as by a brain lesion) to an area of the brain (as Wernicke's area) concerned with language.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sensory%20aphasia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000218"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aphasia that is characterized by a loss of ability to properly enunciate words.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/aphasia#causes</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nidcd.nih.gov/health/aphasia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000217"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aphasia that is characterized by a loss of ability to form words.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/aphasia#causes</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nidcd.nih.gov/health/aphasia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000216"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aphasia that is characterized by a loss of ability to speak.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/aphasia#causes</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nidcd.nih.gov/health/aphasia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000215"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aphasia that is characterized by a loss of ability to comprehend speech.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/aphasia#causes</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nidcd.nih.gov/health/aphasia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000214"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aphasia that is characterized by a severe problem with recalling words or names.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Anomia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000213"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An aphasia that is characterized by a pathological loss of the ability to write.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=agraphia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000207"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fever that is characterized by the state of being free from fever.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=afebrile</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000201"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A meningoencephalitis that is characterized by a severe and sudden onset.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/imagepages/18126.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000199"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abortion that is characterized by the natural occurring expulsion of a nonviable fetus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=spontaneous%20abortion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000198"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by the spontaneous expulsion of a human fetus before it is viable and especially between the 12th and 28th weeks of gestation.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=miscarriage</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000197"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A reproductive system symptom that is characterized by the expulsion of a fetus at any time before completion of pregnancy and is often due to infection.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=abortion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000187"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fatigue that is characterized by a feeling of a lessened capacity for work and reduced efficiency of accomplishment, usually accompanied by a sense of weariness and fatigue.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.medicinenet.com/tired/definition.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000186"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fatigue that is characterized by a feeling of weariness (bodily or mental) or feeling of weakness.  Exhaustion is a shorter-lived form of fatigue that can be experienced emotionally, mentally, and physically.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://wellteq.co/insights/mental-health/fatigue-burnout-and-exhaustion-whats-the-difference</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.dictionary.com/browse/fatigue</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000185"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fatigue that is characterized by a feeling of exhaustion in strength, endurance, and vigor.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merriam-webster.com/dictionary/weary</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000178"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight symptom that is characterized by a reduction of the total body mass, by a mean loss of fluid, body fat (adipose tissue), or lean mass (namely bone mineral deposits, muscle, tendon, and other connective tissue). Weight loss can either occur unintentionally because of malnourishment or an underlying disease.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Weight_loss</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000174"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by the unintended loss of weight and lean body tissue characteristic of many diseases (as cancer, tuberculosis, and AIDS).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=wasting</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000164"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A coordination symptom that is characterized by a loss of complicated body movements, which may be caused by disease, injury, or toxins.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.merckmanuals.com/home/brain,-spinal-cord,-and-nerve-disorders/movement-disorders/coordination-disorders</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000162"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tremor is a generial symptom characterized by a trembling or shaking usually from physical weakness, emotional stress, or disease.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=tremor</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000156"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Thirst is a general symptom characterized by a sensation of dryness in the mouth and throat associated with a desire for liquids.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=thirst</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000144"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pneumonia that is characterized by acute inflammation of the bronchi, accompanied by inflamed patches in the nearby lobules of the lungs</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://en.wikipedia.org/wiki/Bronchopneumonia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000141"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by an abnormal increase in muscle tone or stiffness of muscle, which might interfere with movement, speech, or be associated with discomfort or pain.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ninds.nih.gov/health-information/disorders/spasticity</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000139"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by a sudden violent spasmodic audible expiration of breath through the nose and mouth especially as a reflex act following irritation of the nasal mucous membrane.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=sneezing</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000136"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin lesion that is characterized by a break in skin with loss of surface tissue, disintegration and necrosis of epithelial tissue, and often pus.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=ulcer</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000132"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Necrosis is a general symptom where death of a portion of tissue differentially affected by local injury (as loss of blood supply, corrosion, burning, or the local lesion of a disease).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=necrosis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000131"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A joint pain that is characterized by a pain situated, or occurring, in or around a joint that is intense (severe).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/severe</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000118"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An abnormal chest sound that is characterized by the clicking, rattling, or crackling noises heard on auscultation of (listening to) the lung with a stethoscope during inhalation. The sounds are caused by the 'popping open' of small airways and alveoli collapsed by fluid, exudate, or lack of aeration during expiration. The word 'rales' derives from the French word rale meaning 'rattle'. Rales can be heard in patients with pneumonia, atelectasis, pulmonary fibrosis, acute bronchitis, or bronchiectasis. Pulmonary edema secondary to left-sided congestive heart failure can also cause rales.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Rales</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000116"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prostration is a general symptom characterized by complete physical or mental exhaustion.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=prostration</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000107"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an exudation of fluid from the blood or lymph into a pleural cavity.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=pleural%20effusion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000102"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an inflammation of the peritoneum.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=peritonitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000099"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A sensation perception that is characterized by an unpleasant sensation that usually indicates the body is threatened or damaged. The sensation may be sharp or dull, short-lived or chronic, intermittent or continual, confined to one area or spread over the entire body.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.nationalpainfoundation.org/MyTreatment/articles/Cancer_PainDefinitions.asp</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000098"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by the acute or chronic inflammation of the kidney affecting the structure (as of the glomerulus or parenchyma) and caused by infection, a degenerative process, or vascular disease.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=nephritis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000092"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an abnormal change in structure of the skin that is especially circumscribed and well defined due to injury or disease.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=lesion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000091"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An encephalitis that is not intense (not severe).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.macmillandictionary.com/us/dictionary/american/mild_1</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000090"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by inflammation of the brain tissue, which is typically caused by a viral infection, but it may also be caused by bacterial or parasitic infections, cancer, or certain drugs or toxins.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.cancer.gov/publications/dictionaries/cancer-terms/def/encephalitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000089"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by an inflammation of the brain and meninges.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=meningoencephalitis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000079"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by the harmonious functioning of interrelated organs and body parts; in particular the working together of muscle groups in the execution of complicated movements.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medical-dictionary.thefreedictionary.com/coordinations</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000075"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A fatigue that is characterized by abnormal drowsiness.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=lethargy</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000064"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by a pain situated, or occurring, in or around a joint.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003261.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000061"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Inflammation is a general symptom where there is a local response to cellular injury that is marked by capillary dilatation, leukocytic infiltration, redness, heat, pain, swelling, and often loss of function and that serves as a mechanism initiating the elimination of noxious agents and of damaged tissue.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=inflammation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000056"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by an excess pigmentation in a bodily part or tissue, as the skin.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hyperpigmentation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000041"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A cardiovascular system symptom that is characterized by an acute loss of blood from a damaged blood vessel.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.ncbi.nlm.nih.gov/books/NBK542273/</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000040"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A urinary system symptom that is characterized by the presence of blood or blood cells in the urine.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=hematuria</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000039"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Enteritis is a digestive system symptom involving the inflammation of the small intestines and especially of the human ileum.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://en.wikipedia.org/wiki/Enteritis</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=enteritis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000038"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by being short or breath or out of air (dyspnea), with inflammation of the small intestine (enteritis).</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/001149.htm</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.cancer.gov/publications/dictionaries/cancer-terms/def/dyspnea</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000030"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by a complete or partial loss of function especially when involving the power of motion or of sensation in any part of the body.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=paralysis</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000025"/>
  <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nonproductive cough</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.healthline.com/health/dry-cough</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000024"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a feeling of being more sleepy than normal during the day. People who are drowsy may fall asleep in when they do not want to or at times which can lead to safety concerns.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://medlineplus.gov/ency/article/003208.htm</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000023"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A confusion that is characterized by an usually transient state of confusion especially as to time, place, or identity; often as a result of disease or drugs.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=disorientation</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000022"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a chronic feeling of emptiness, sadness, or inability to feel pleasure that may appear to happen for no clear reason.  Additionally one may experience feelings of hopelessness, pessimism, irritability, frustration, or restlessness, guilt, worthlessness and thoughts of death or suicide.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.medicalnewstoday.com/articles/8933</oboI:hasDbXref>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:https://www.nimh.nih.gov/health/topics/depression</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000021"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by a mental disturbance characterized by confusion, disordered speech, and hallucinations.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=delirium</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000020"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nutrition, metabolism, and development symptom that is characterized by an abnormal depletion of body fluids.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=dehydration</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000016"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A balance symptom that is characterized by a disturbance of consciousness characterized by inability to engage in orderly thought or by lack of power to distinguish, choose, or act decisively.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=confusion</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000009"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A skin and integumentary tissue symptom that is characterized by a fluid-filled elevation of the epidermis.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=blister</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000007"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A general symptom that is characterized as an act, instance, or result of being bled or the process by which something is bled: as a the escape of blood from vessels.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www.merriam-webster.com/medlineplus/bleeding</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000006"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A pain that is characterized by occurring in the lower back.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=backache</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000005"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A neurological and physiological symptom that is characterized by an inability to coordinate voluntary muscular movements that is symptomatic of some nervous disorders.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=ataxia</oboI:hasDbXref>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000000"/>
  <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
  <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cellulitis is a musculoskeletal system symptom characterized as a diffuse and especially subcutaneous inflammation of connective tissue.</owl:annotatedTarget>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">url:http://www2.merriam-webster.com/cgi-bin/mwmednlm?book=Medical&amp;va=cellulitis</oboI:hasDbXref>
</owl:Axiom>


</rdf:RDF>
