</owl:Class>

<owl:Class rdf:about="#Vomito">
  <rdfs:subClassOf rdf:resource="#Sintoma"/>
</owl:Class>

<owl:Class rdf:about="#Convulsao">
  <rdfs:subClassOf rdf:resource="#Sintoma"/>
</owl:Class>

<owl:Class rdf:about="#ManchaNegra">
  <rdfs:subClassOf rdf:resource="#Sintoma"/>
</owl:Class>

<owl:Class rdf:about="#SerVivo">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Animal">
  <rdfs:subClassOf rdf:resource="#SerVivo"/>
  <owl:disjointWith rdf:resource="#Pessoa"/>
</owl:Class>

<owl:Class rdf:about="#RatoNegro">
  <rdfs:subClassOf rdf:resource="#Animal"/>
  <owl:disjointWith rdf:resource="#Gato"/>
</owl:Class>

<owl:Class rdf:about="#Gato">
  <rdfs:subClassOf rdf:resource="#Animal"/>
</owl:Class>

<owl:Class rdf:about="#Pessoa">
  <rdfs:subClassOf rdf:resource="#SerVivo"/>
</owl:Class>

<owl:Class rdf:about="#Europeu">
  <rdfs:subClassOf rdf:resource="#Pessoa"/>
  <owl:disjointWith rdf:resource="#Judeu"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#atribuiuCausaA"/>
      <owl:someValuesFrom rdf:resource="#Judeu"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Judeu">
  <rdfs:subClassOf rdf:resource="#Pessoa"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#supostamenteTrouxe"/>
      <owl:someValuesFrom rdf:resource="#PesteNegra"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#supostamenteEnvenenou"/>
      <owl:someValuesFrom rdf:resource="#PocoDeAgua"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#EventoHistorico">
