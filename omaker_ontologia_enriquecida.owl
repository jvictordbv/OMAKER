  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lack of expected normal physiological development in childhood that is characterized by a failure for a child to reach a significant stage at the predicted age and may include walking or talking.</obo:IAO_0000115>
  <oboI:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ICD9CM_2005:783.42</oboI:hasDbXref>
