  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">obsolete suppurative pneumonia</rdfs:label>
  <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
</owl:Class>

