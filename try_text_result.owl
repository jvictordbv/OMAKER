         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://omaker.org/onto/try_text_result.owl"
         xmlns="http://omaker.org/onto/try_text_result.owl#">

<owl:Ontology rdf:about="http://omaker.org/onto/try_text_result.owl"/>

<owl:ObjectProperty rdf:about="#treats">
