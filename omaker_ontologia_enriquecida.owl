<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0019151">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000514"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory system and chest symptom that is characterized by an abnormal accumulation of fluid in the lungs.</obo:IAO_0000115>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">oedematous lungs</oboI:hasExactSynonym>
