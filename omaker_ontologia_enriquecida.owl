  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <owl:equivalentClass rdf:resource="#Enfermidade"/>
  <owl:equivalentClass rdf:resource="#Patologia"/>
</owl:Class>

