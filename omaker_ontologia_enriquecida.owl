  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000450</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">shock</rdfs:label>
</owl:Class>

