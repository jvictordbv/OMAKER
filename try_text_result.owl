</owl:Class>

<owl:NamedIndividual rdf:about="#metformin">
  <rdf:type rdf:resource="#Antidiabetic"/>
  <treats rdf:resource="#type_2_diabetes"/>
  <causes rdf:resource="#vitamin_B12_deficiency"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">metformin</rdfs:label>
</owl:NamedIndividual>

