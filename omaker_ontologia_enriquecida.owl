  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000215"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An inability to comprehend speech that is characterized by an inability to understand spoken, written, or tactile speech symbols that results from damage (as by a brain lesion) to an area of the brain (as Wernicke's area) concerned with language.</obo:IAO_0000115>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wernicke's aphasia</oboI:hasExactSynonym>
