  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000462</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptom</rdfs:label>
</owl:Class>

