<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="#teste peste negra.owl"
         xmlns="#teste peste negra.owl#">

<owl:Ontology rdf:about="#teste peste negra.owl"/>

<owl:ObjectProperty rdf:about="#eTransmitidaPor">
  <rdfs:domain rdf:resource="#PesteNegra"/>
  <rdfs:range rdf:resource="#RatoNegro"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#causa">
