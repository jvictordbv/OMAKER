  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000730</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rapid respiration</rdfs:label>
</owl:Class>

