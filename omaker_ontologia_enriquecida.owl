  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">insomnia with sleep apnea</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000580">
