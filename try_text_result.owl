  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">vitamin B12 deficiency</rdfs:label>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Aspirin">
  <rdf:type rdf:resource="#Antiplatelet"/>
