  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acute diarrhea</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000676">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000039"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acute enteritis is a enteritis with either or both a rapid onset and a short course which is usually due to bacteria or virus.</obo:IAO_0000115>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000676</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acute enteritis</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000677">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019159"/>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000677</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acute gastroenteritis</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000678">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000480"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by a severe and sudden onset of disturbance in the normal operation of one's cognition, emotional regulation, or behaviour.</obo:IAO_0000115>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000678</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acute mental dysfunction</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000679">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019153"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A dyspnea that is characterized by a severe and sudden onset.</obo:IAO_0000115>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000679</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acute dyspnea</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0019153">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000598"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A respiratory abnormality that is characterized by difficult or labored respiration.</obo:IAO_0000115>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">breathing difficulty</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">breathlessness</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">difficulty breathing</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">labored respiration</oboI:hasExactSynonym>
  <oboI:hasExactSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">shortness of breath</oboI:hasExactSynonym>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0019153</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dyspnea</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000680">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000178"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A weight loss that is characterized by a severe and sudden onset.</obo:IAO_0000115>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000680</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">acute weight loss</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000681">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0019182"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A behavioral symptom that is characterized by behavior aimed at harming a person, or animal, or damaging physical property.</obo:IAO_0000115>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000681</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">aggressive behavior</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000682">
  <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000480"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A nervous system symptom that is characterized by a host of presentations that include changes in cognition, mood, behavior, and/or level of arousal.</obo:IAO_0000115>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000682</oboI:id>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">altered mental status</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://purl.obolibrary.org/obo/SYMP_0000683">
  <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000603"/>
  <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tachypnoea is a respiratory system and chest symptom characterized by an increased rate of respiration.</obo:IAO_0000115>
  <oboI:hasOBONamespace rdf:datatype="http://www.w3.org/2001/XMLSchema#string">symptoms</oboI:hasOBONamespace>
  <oboI:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SYMP:0000683</oboI:id>
